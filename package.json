{
  "name": "ab-apps",
  "productName": "AB Apps",
  "version": "1.0.0",
  "description": "Installs, updates and opens Anabaptist Brotherhood's in-house apps, and signs people in once for all of them.",
  "author": "Anabaptist Brotherhood",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "preversion": "npm test",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "ab-common": "git+https://github.com/AB-Kevin/ab-common.git#v1.1.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.anabaptistbrotherhood.abapps",
    "productName": "AB Apps",
    "files": [
      "src/**/*",
      "catalog.json",
      "build/icon.png",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "AB-Kevin",
      "repo": "ab-apps",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "ABApps-Setup-${version}.${ext}"
    }
  }
}
